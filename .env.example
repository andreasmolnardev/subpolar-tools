SUBPOLAR_ADMIN_EMAIL=admin@example.com
SUBPOLAR_ADMIN_PASSWORD=change-this-before-deploying
SUBPOLAR_SECRET_KEY=use-a-random-32-byte-or-longer-secret
# Enable only for local development; this writes reset links to logs.
SUBPOLAR_LOG_EMAIL_TOKENS=false
PB_URL=http://127.0.0.1:8090
SUBPOLAR_ORIGIN=http://localhost:3000
# Absolute host path used for worktrees and mounted into sandbox containers.
SUBPOLAR_WORKSPACE_ROOT=/var/lib/subpolar/workspaces
