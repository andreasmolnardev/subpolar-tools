{
  "name": "subpolar-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --filter @subpolar/api dev",
    "dev:web": "bun --filter @subpolar/web dev",
    "build": "bun --filter @subpolar/web build && bun --filter @subpolar/runtime typecheck && bun --filter @subpolar/api typecheck",
    "start": "bun --filter @subpolar/api start",
    "test": "bun test tests",
    "test:integration": "bun test tests",
    "test:e2e": "sh scripts/e2e.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "concurrently": "^9.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
